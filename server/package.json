{
  "name": "ioayn-mcp",
  "version": "1.1.3",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node20 --outfile=dist/index.js --banner:js=\"#!/usr/bin/env node\"",
    "typecheck": "tsc --noEmit",
    "test:smoke": "node scripts/smoke-test.mjs && node scripts/hook-capture-test.mjs && node scripts/migration-test.mjs && npm run test:fixtures",
    "schemas": "esbuild src/export-schemas.ts --bundle --platform=node --format=esm --target=node20 --outfile=dist/export-schemas.js && node dist/export-schemas.js ../schemas",
    "test:fixtures": "esbuild src/validate-fixtures.ts --bundle --platform=node --format=esm --target=node20 --outfile=dist/validate-fixtures.js && node dist/validate-fixtures.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "esbuild": "0.27.0",
    "typescript": "5.9.3"
  }
}
