{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.1"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,119}$"
    },
    "session_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,119}$"
    },
    "round_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,119}$"
    },
    "external_session_id": {
      "type": "string"
    },
    "actor": {
      "type": "string",
      "enum": [
        "user",
        "agent",
        "tool",
        "system"
      ]
    },
    "kind": {
      "type": "string",
      "enum": [
        "prompt",
        "teaching",
        "checkpoint",
        "answer",
        "tool_observation",
        "compact_summary",
        "event"
      ]
    },
    "content": {
      "type": "string"
    },
    "related_entities": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9_-]{0,119}$"
      }
    },
    "related_assets": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9_-]{0,119}$"
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    }
  },
  "required": [
    "schema_version",
    "id",
    "session_id",
    "actor",
    "kind",
    "content",
    "related_entities",
    "related_assets",
    "created_at"
  ],
  "additionalProperties": false,
  "$id": "urn:ioayn:schema:conversation-turn:1.1",
  "title": "ConversationTurn"
}
