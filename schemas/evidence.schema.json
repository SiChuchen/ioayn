{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.1"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,119}$"
    },
    "goal_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,119}$"
    },
    "slice_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,119}$"
    },
    "round_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,119}$"
    },
    "claim": {
      "type": "string",
      "minLength": 1
    },
    "claim_type": {
      "type": "string",
      "enum": [
        "fact",
        "inference",
        "unknown",
        "conflict"
      ]
    },
    "kind": {
      "type": "string",
      "enum": [
        "source",
        "test",
        "runtime_trace",
        "log",
        "network",
        "database",
        "git",
        "documentation"
      ]
    },
    "source": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        },
        "symbol": {
          "type": "string"
        },
        "lines": {
          "type": "string"
        },
        "command": {
          "type": "string"
        },
        "artifact": {
          "type": "string"
        },
        "observation": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "confidence": {
      "type": "string",
      "enum": [
        "high",
        "medium",
        "low"
      ]
    },
    "basis_refs": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9_-]{0,119}$"
      }
    },
    "limitations": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "revision": {
      "type": "object",
      "properties": {
        "branch": {
          "type": "string",
          "minLength": 1
        },
        "commit": {
          "type": "string",
          "minLength": 7
        },
        "dirty": {
          "type": "boolean"
        }
      },
      "required": [
        "branch",
        "commit",
        "dirty"
      ],
      "additionalProperties": false
    },
    "verified_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    }
  },
  "required": [
    "schema_version",
    "id",
    "goal_id",
    "claim",
    "claim_type",
    "kind",
    "source",
    "confidence",
    "basis_refs",
    "limitations",
    "revision",
    "verified_at"
  ],
  "additionalProperties": false,
  "$id": "urn:ioayn:schema:evidence:1.1",
  "title": "Evidence"
}
