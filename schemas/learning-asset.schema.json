{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.1"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,119}$"
    },
    "goal_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,119}$"
    },
    "slice_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,119}$"
    },
    "type": {
      "type": "string",
      "enum": [
        "flow_understanding",
        "contract",
        "concept",
        "decision",
        "error_path",
        "state_model",
        "architecture_fragment"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 180
    },
    "question": {
      "type": "string",
      "minLength": 1
    },
    "body_markdown": {
      "type": "string",
      "minLength": 1
    },
    "source_turn_refs": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9_-]{0,119}$"
      }
    },
    "context": {
      "type": "object",
      "properties": {
        "system_area": {
          "type": "string",
          "minLength": 1
        },
        "abstraction_level": {
          "type": "string",
          "enum": [
            "L0",
            "L1",
            "L2",
            "L3",
            "L4",
            "L5"
          ]
        }
      },
      "required": [
        "system_area",
        "abstraction_level"
      ],
      "additionalProperties": false
    },
    "input": {
      "type": "object",
      "properties": {
        "source": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "meaning": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "output": {
      "type": "object",
      "properties": {
        "consumer": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "meaning": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "key_entities": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]{0,119}$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "default": "code_entity",
            "type": "string",
            "minLength": 1
          },
          "role": {
            "type": "string",
            "minLength": 1
          },
          "input": {
            "type": "string"
          },
          "action": {
            "type": "string"
          },
          "output": {
            "type": "string"
          },
          "source": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string"
              },
              "symbol": {
                "type": "string"
              },
              "lines": {
                "type": "string"
              },
              "command": {
                "type": "string"
              },
              "artifact": {
                "type": "string"
              },
              "observation": {
                "type": "string"
              }
            },
            "additionalProperties": false
          },
          "map": {
            "default": false,
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "name",
          "kind",
          "role",
          "map"
        ],
        "additionalProperties": false
      }
    },
    "concepts": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "claims": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]{0,119}$"
          },
          "type": {
            "type": "string",
            "enum": [
              "fact",
              "inference",
              "unknown",
              "conflict"
            ]
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "confidence": {
            "type": "string",
            "enum": [
              "high",
              "medium",
              "low"
            ]
          },
          "evidence_refs": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9_-]{0,119}$"
            }
          },
          "basis_refs": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9_-]{0,119}$"
            }
          },
          "limitations": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "id",
          "type",
          "text",
          "confidence",
          "evidence_refs",
          "basis_refs",
          "limitations"
        ],
        "additionalProperties": false
      }
    },
    "evidence_refs": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9_-]{0,119}$"
      }
    },
    "unknown_refs": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9_-]{0,119}$"
      }
    },
    "learned_from": {
      "type": "object",
      "properties": {
        "session_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]{0,119}$"
        },
        "round_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]{0,119}$"
        }
      },
      "required": [
        "session_id",
        "round_id"
      ],
      "additionalProperties": false
    },
    "atlas_node_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,119}$"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "verified",
        "revised",
        "superseded"
      ]
    },
    "revision": {
      "type": "object",
      "properties": {
        "branch": {
          "type": "string",
          "minLength": 1
        },
        "commit": {
          "type": "string",
          "minLength": 7
        },
        "dirty": {
          "type": "boolean"
        }
      },
      "required": [
        "branch",
        "commit",
        "dirty"
      ],
      "additionalProperties": false
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    }
  },
  "required": [
    "schema_version",
    "id",
    "goal_id",
    "slice_id",
    "type",
    "title",
    "question",
    "body_markdown",
    "source_turn_refs",
    "context",
    "key_entities",
    "concepts",
    "claims",
    "evidence_refs",
    "unknown_refs",
    "learned_from",
    "atlas_node_id",
    "status",
    "revision",
    "created_at",
    "updated_at"
  ],
  "additionalProperties": false,
  "$id": "urn:ioayn:schema:learning-asset:1.1",
  "title": "LearningAsset"
}
