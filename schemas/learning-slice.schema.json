{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.1"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,119}$"
    },
    "goal_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,119}$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "question": {
      "type": "string",
      "minLength": 1
    },
    "abstraction_level": {
      "type": "string",
      "enum": [
        "L0",
        "L1",
        "L2",
        "L3",
        "L4",
        "L5"
      ]
    },
    "stage": {
      "type": "string",
      "enum": [
        "goal_defined",
        "entry_discovered",
        "boundary_modeled",
        "flow_traced",
        "unknowns_classified",
        "details_expanded",
        "runtime_verified",
        "user_checked",
        "completed"
      ]
    },
    "observable_anchor": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "location": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "boundary": {
      "type": "object",
      "properties": {
        "inside": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "outside": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "inside",
        "outside"
      ],
      "additionalProperties": false
    },
    "participants": {
      "minItems": 1,
      "maxItems": 30,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]{0,119}$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "minLength": 1
          },
          "input": {
            "type": "object",
            "properties": {
              "producer": {
                "type": "string"
              },
              "type": {
                "type": "string"
              },
              "meaning": {
                "type": "string"
              },
              "preconditions": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "additionalProperties": false
          },
          "reads": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "transformations": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "output": {
            "type": "object",
            "properties": {
              "consumer": {
                "type": "string"
              },
              "type": {
                "type": "string"
              },
              "meaning": {
                "type": "string"
              }
            },
            "additionalProperties": false
          },
          "writes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "side_effects": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "failures": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "source": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string"
              },
              "symbol": {
                "type": "string"
              },
              "lines": {
                "type": "string"
              },
              "command": {
                "type": "string"
              },
              "artifact": {
                "type": "string"
              },
              "observation": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "name",
          "role"
        ],
        "additionalProperties": false
      }
    },
    "flow": {
      "type": "object",
      "properties": {
        "nodes": {
          "minItems": 1,
          "maxItems": 30,
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]{0,119}$"
          }
        },
        "edges": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "from": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9_-]{0,119}$"
              },
              "to": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9_-]{0,119}$"
              },
              "relation": {
                "type": "string",
                "enum": [
                  "calls",
                  "produces",
                  "consumes",
                  "transforms",
                  "reads",
                  "writes",
                  "publishes",
                  "receives",
                  "transitions",
                  "returns",
                  "fails_to"
                ]
              },
              "data": {
                "type": "string"
              },
              "condition": {
                "type": "string"
              },
              "evidence_refs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9_-]{0,119}$"
                }
              }
            },
            "required": [
              "from",
              "to",
              "relation"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "nodes",
        "edges"
      ],
      "additionalProperties": false
    },
    "state_changes": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "side_effects": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "failure_paths": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "introduced_entities": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]{0,119}$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "default": "code_entity",
            "type": "string",
            "minLength": 1
          },
          "role": {
            "type": "string",
            "minLength": 1
          },
          "input": {
            "type": "string"
          },
          "action": {
            "type": "string"
          },
          "output": {
            "type": "string"
          },
          "source": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string"
              },
              "symbol": {
                "type": "string"
              },
              "lines": {
                "type": "string"
              },
              "command": {
                "type": "string"
              },
              "artifact": {
                "type": "string"
              },
              "observation": {
                "type": "string"
              }
            },
            "additionalProperties": false
          },
          "map": {
            "default": false,
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "name",
          "kind",
          "role",
          "map"
        ],
        "additionalProperties": false
      }
    },
    "evidence_refs": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9_-]{0,119}$"
      }
    },
    "unknown_refs": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9_-]{0,119}$"
      }
    },
    "round_refs": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9_-]{0,119}$"
      }
    },
    "checkpoint": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]{0,119}$"
        },
        "level": {
          "type": "string",
          "enum": [
            "L0",
            "L1",
            "L2",
            "L3",
            "L4",
            "L5"
          ]
        },
        "difficulty": {
          "default": "current_level",
          "type": "string",
          "enum": [
            "foundation",
            "current_level",
            "stretch"
          ]
        },
        "question": {
          "type": "string",
          "minLength": 1
        },
        "expected_elements": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "user_answer": {
          "type": "string"
        },
        "assessment": {
          "default": "not_asked",
          "type": "string",
          "enum": [
            "not_asked",
            "pending",
            "passed",
            "needs_repair"
          ]
        },
        "feedback": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "level",
        "difficulty",
        "question",
        "expected_elements",
        "assessment"
      ],
      "additionalProperties": false
    },
    "summary": {
      "type": "string"
    },
    "atlas_node_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,119}$"
    },
    "revision": {
      "type": "object",
      "properties": {
        "branch": {
          "type": "string",
          "minLength": 1
        },
        "commit": {
          "type": "string",
          "minLength": 7
        },
        "dirty": {
          "type": "boolean"
        }
      },
      "required": [
        "branch",
        "commit",
        "dirty"
      ],
      "additionalProperties": false
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    }
  },
  "required": [
    "schema_version",
    "id",
    "goal_id",
    "title",
    "question",
    "abstraction_level",
    "stage",
    "boundary",
    "participants",
    "flow",
    "state_changes",
    "side_effects",
    "failure_paths",
    "introduced_entities",
    "evidence_refs",
    "unknown_refs",
    "round_refs",
    "revision",
    "created_at",
    "updated_at"
  ],
  "additionalProperties": false,
  "$id": "urn:ioayn:schema:learning-slice:1.1",
  "title": "LearningSlice"
}
