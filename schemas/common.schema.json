{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ioayn:schema:common:1.1",
  "title": "IOAYN Common Types",
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,119}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "abstraction_level": {
      "type": "string",
      "enum": ["L0", "L1", "L2", "L3", "L4", "L5"]
    },
    "confidence": {
      "type": "string",
      "enum": ["high", "medium", "low"]
    },
    "claim_type": {
      "type": "string",
      "enum": ["fact", "inference", "unknown", "conflict"]
    },
    "revision": {
      "type": "object",
      "required": ["branch", "commit", "dirty"],
      "properties": {
        "branch": { "type": "string", "minLength": 1 },
        "commit": { "type": "string", "minLength": 7 },
        "dirty": { "type": "boolean" }
      },
      "additionalProperties": false
    }
  }
}
