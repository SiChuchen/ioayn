{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.1"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,119}$"
    },
    "session_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,119}$"
    },
    "goal_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,119}$"
    },
    "slice_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,119}$"
    },
    "index": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "abstraction_level": {
      "type": "string",
      "enum": [
        "L0",
        "L1",
        "L2",
        "L3",
        "L4",
        "L5"
      ]
    },
    "active_question": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "user_turn_refs": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9_-]{0,119}$"
      }
    },
    "agent_turn_refs": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9_-]{0,119}$"
      }
    },
    "introduced_entities": {
      "default": [],
      "maxItems": 12,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]{0,119}$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "default": "code_entity",
            "type": "string",
            "minLength": 1
          },
          "role": {
            "type": "string",
            "minLength": 1
          },
          "input": {
            "type": "string"
          },
          "action": {
            "type": "string"
          },
          "output": {
            "type": "string"
          },
          "source": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string"
              },
              "symbol": {
                "type": "string"
              },
              "lines": {
                "type": "string"
              },
              "command": {
                "type": "string"
              },
              "artifact": {
                "type": "string"
              },
              "observation": {
                "type": "string"
              }
            },
            "additionalProperties": false
          },
          "map": {
            "default": false,
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "name",
          "kind",
          "role",
          "map"
        ],
        "additionalProperties": false
      }
    },
    "claims": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]{0,119}$"
          },
          "type": {
            "type": "string",
            "enum": [
              "fact",
              "inference",
              "unknown",
              "conflict"
            ]
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "confidence": {
            "type": "string",
            "enum": [
              "high",
              "medium",
              "low"
            ]
          },
          "evidence_refs": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9_-]{0,119}$"
            }
          },
          "basis_refs": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9_-]{0,119}$"
            }
          },
          "limitations": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "id",
          "type",
          "text",
          "confidence",
          "evidence_refs",
          "basis_refs",
          "limitations"
        ],
        "additionalProperties": false
      }
    },
    "evidence_refs": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9_-]{0,119}$"
      }
    },
    "unknown_refs": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9_-]{0,119}$"
      }
    },
    "checkpoint": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]{0,119}$"
        },
        "level": {
          "type": "string",
          "enum": [
            "L0",
            "L1",
            "L2",
            "L3",
            "L4",
            "L5"
          ]
        },
        "difficulty": {
          "default": "current_level",
          "type": "string",
          "enum": [
            "foundation",
            "current_level",
            "stretch"
          ]
        },
        "question": {
          "type": "string",
          "minLength": 1
        },
        "expected_elements": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "user_answer": {
          "type": "string"
        },
        "assessment": {
          "default": "not_asked",
          "type": "string",
          "enum": [
            "not_asked",
            "pending",
            "passed",
            "needs_repair"
          ]
        },
        "feedback": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "level",
        "difficulty",
        "question",
        "expected_elements",
        "assessment"
      ],
      "additionalProperties": false
    },
    "learning_asset_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,119}$"
    },
    "atlas_node_refs": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9_-]{0,119}$"
      }
    },
    "atlas_edge_refs": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9_-]{0,119}$"
      }
    },
    "next_actions": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "revision": {
      "type": "object",
      "properties": {
        "branch": {
          "type": "string",
          "minLength": 1
        },
        "commit": {
          "type": "string",
          "minLength": 7
        },
        "dirty": {
          "type": "boolean"
        }
      },
      "required": [
        "branch",
        "commit",
        "dirty"
      ],
      "additionalProperties": false
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    }
  },
  "required": [
    "schema_version",
    "id",
    "session_id",
    "goal_id",
    "slice_id",
    "index",
    "abstraction_level",
    "active_question",
    "summary",
    "user_turn_refs",
    "agent_turn_refs",
    "introduced_entities",
    "claims",
    "evidence_refs",
    "unknown_refs",
    "atlas_node_refs",
    "atlas_edge_refs",
    "next_actions",
    "revision",
    "created_at",
    "updated_at"
  ],
  "additionalProperties": false,
  "$id": "urn:ioayn:schema:learning-round:1.1",
  "title": "LearningRound"
}
